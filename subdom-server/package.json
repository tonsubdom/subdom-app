{
  "name": "subdom",
  "version": "1.0.0",
  "description": "Сервер для создания и управлениями субдоменами",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_ENV=development ts-node-dev --respawn --transpile-only src/start.ts",
    "dev:sqlite": "NODE_ENV=development ts-node-dev --respawn --transpile-only src/server-sqlite.ts",
    "dev:telegram": "NODE_ENV=development ts-node-dev --respawn --transpile-only --ignore src/utils/telegramBot-sqlite.ts src/server-sqlite.ts",
    "dev:simple": "ts-node-dev --respawn --transpile-only src/simple-server.ts",
    "dev:mongodb": "NODE_ENV=development MONGODB_URI=mongodb://localhost:27017/nft-domains ts-node-dev --respawn --transpile-only src/start.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/start.js",
    "start:dev": "NODE_ENV=development node dist/start.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "domain",
    "chat",
    "server",
    "express",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.5.0",
    "buildx": "^0.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "mongoose": "^7.5.0",
    "node-telegram-bot-api": "^0.66.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "@types/node-telegram-bot-api": "^0.64.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}


// src/hooks/useAdminAccess.ts
import { useState, useEffect, useCallback } from 'react';
import { useTonAddress } from "@tonconnect/ui-react";
import { convertRawToUserFriendlyTest } from '@/utils/tonUtils';

const OWNER_ADDRESS = '0QA29QkUF1-wLUQCu5VYadM5qPfFGdTpzrC7CPSJZ7EtWP4w';

export const useAdminAccess = () => {
  const [clickCount, setClickCount] = useState<number>(0);
  const [lastClickTime, setLastClickTime] = useState<number>(0);
  const address = useTonAddress();
  // Конвертируем адрес в тестнет формат (начинается с 0Q)
  console.log(`Кошелек address для входа в админ-панель: ${address}`);
  const testnetAddress = convertRawToUserFriendlyTest(address);
  console.log(`Конвертированный Кошелек testnetAddress для входа в админ-панель: ${testnetAddress}`);

  // Сбрасываем счетчик через 3 секунды
  useEffect(() => {
    if (clickCount > 0) {
      const timer = setTimeout(() => {
        setClickCount(0);
      }, 3000);

      return () => clearTimeout(timer);
    }
  }, [clickCount]);

  const handleSubdomClick = useCallback(() => {
    const now = Date.now();
    
    // Если прошло больше 3 секунд с последнего клика, сбрасываем счетчик
    if (now - lastClickTime > 3000) {
      setClickCount(1);
    } else {
      setClickCount(prev => prev + 1);
    }
    
    setLastClickTime(now);

    // Если нажали 5 раз и это владелец
    if (clickCount + 1 >= 5 && testnetAddress === OWNER_ADDRESS) {
      // Используем window.location для навигации
      window.location.href = '/#/admin';
      setClickCount(0); // Сбрасываем счетчик после перехода
    }
  }, [clickCount, lastClickTime, address, testnetAddress]);

  return {
    clickCount,
    handleSubdomClick,
    isOwner: testnetAddress === OWNER_ADDRESS
  };
};
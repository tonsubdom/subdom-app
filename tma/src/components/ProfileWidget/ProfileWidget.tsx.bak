          }}>
            <span style={{ fontSize: '10px' }}>
              {isTestnet ? '🟡' : '🟢'}
            </span>
            <span>{isTestnet ? 'Testnet' : 'Mainnet'}</span>
          </div>) }
            
            </div>
            
          </div>

          <button
            onClick={() => setIsExpanded(false)}
            style={{
              background: "none",
